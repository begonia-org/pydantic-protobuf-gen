    {{ field.name }}: {% if not field.required %}Optional[{% endif %}{% if field.repeated %}List[{% endif %}{{ rendered_type }}{% if field.repeated %}]{% endif %}{% if not field.required %}]{% endif %} = {% if message.as_table %}Field{% else %}_Field{% endif %}({{field.attributes }})
{%endfor %}

    def to_protobuf(self) -> _message.Message:
