  private defaultToken: TokenResponse | null = null;
  private axiosInstance: AxiosInstance;

  constructor(
    baseUrl: string,
    clientId: string,
    clientSecret: string,
    openidDiscoveryUrl: string,
    timeout: number = 30000
  ) {
    this.baseUrl = baseUrl.replace(/\/$/, '');
    this.timeout = timeout;
    this.clientId = clientId;
    this.clientSecret = clientSecret;

    this.axiosInstance = axios.create({
      timeout: this.timeout,
      baseURL: this.baseUrl,
    });

    this.initializeAuth(openidDiscoveryUrl);
  }

  private async initializeAuth(openidDiscoveryUrl: string): Promise<void> {
    try {
      // Get OpenID configuration
      const configResponse = await axios.get<OpenIDConfiguration>(openidDiscoveryUrl);
      this.tokenUrl = configResponse.data.token_endpoint;

      // Get Access Token (Client Credentials Flow)
      const tokenResponse = await axios.post<TokenResponse>(
        this.tokenUrl,
        new URLSearchParams({
          grant_type: 'client_credentials',
          client_id: this.clientId,
          client_secret: this.clientSecret,
        }),
        {
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
        }
      );

      this.defaultToken = tokenResponse.data;
    } catch (error) {
      console.error('Failed to initialize authentication:', error);
      throw error;
    }
  }

  private buildHeaders(extraHeaders?: Record<string, string>): Record<string, string> {
    const headers: Record<string, string> = {
      'Content-Type': 'application/json',
    };

    if (this.defaultToken) {
      headers.Authorization = `${this.defaultToken.token_type} ${this.defaultToken.access_token}`;
    }

    if (extraHeaders) {
      Object.assign(headers, extraHeaders);
    }

    return headers;
  }

  private buildWebSocketUri(path: string): string {
    const url = new URL(this.baseUrl);
    const wsScheme = url.protocol === 'https:' ? 'wss:' : 'ws:';
    return `${wsScheme}//${url.host}/${path.replace(/^\//, '')}`;
  }

