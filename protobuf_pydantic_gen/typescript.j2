    /**{{ method_name }} - Bidirectional streaming RPC call*/
    const uri = this.buildWebSocketUri('{{ http_path }}');
    const extraHeaders = this.buildHeaders(headers);

    const messageQueue: {{ output_type }}[] = [];
    let isConnected = false;
    let connectionError: Error | null = null;

    return new Promise<AsyncGenerator<{{ output_type }}, void, unknown>>((resolve, reject) => {
      const ws = new WebSocket(uri, { headers: extraHeaders });
      let shouldClose = false;

      const generator = (async function* () {
        // Wait for connection to be established
        while (!isConnected && !connectionError) {
          await new Promise(resolve => setTimeout(resolve, 10));
        }

        if (connectionError) {
          throw connectionError;
        }

        // Send input stream in background
        (async () => {
          try {
            for await (const request of inputStream) {
              if (shouldClose) break;
              ws.send(JSON.stringify(request));
            }
          } catch (error) {
            console.error('Error sending input:', error);
          } finally {
            shouldClose = true;
          }
        })();

        // Yield messages as they arrive
        while (!shouldClose || messageQueue.length > 0) {
          if (messageQueue.length > 0) {
            yield messageQueue.shift()!;
          } else {
            await new Promise(resolve => setTimeout(resolve, 10));
          }
        }
      })();

      ws.on('open', () => {
        isConnected = true;
        resolve(generator);
      });

      ws.on('message', (data: WebSocket.Data) => {
        try {
          const message = JSON.parse(data.toString());
          const responseData = 'data' in message ? message.data : message;
          messageQueue.push(responseData as {{ output_type }});
        } catch (error) {
          console.error('Failed to parse WebSocket message:', error);
        }
      });

      ws.on('close', () => {
        console.log('WebSocket connection closed');
        shouldClose = true;
      });

      ws.on('error', (error) => {
        console.error('Error in bidirectional streaming:', error);
        connectionError = error;
        if (!isConnected) {
          reject(error);
        }
      });
    });
  }

