{% elif streaming_type == "client_streaming" %}
  async {{ snake_name }}(
    inputStream: AsyncGenerator<{{ input_type }}, void, unknown>,
    headers?: Record<string, string>
  ): Promise<{{ output_type }}> {
    /**{{ method_name }} - Client streaming RPC call*/
    const uri = this.buildWebSocketUri('{{ http_path }}');
    const extraHeaders = this.buildHeaders(headers);

    return new Promise<{{ output_type }}>((resolve, reject) => {
      const ws = new WebSocket(uri, { headers: extraHeaders });

      ws.on('open', async () => {
        try {
          // Send all input requests
          for await (const request of inputStream) {
            ws.send(JSON.stringify(request));
          }

          // Signal end of input stream
          ws.send(JSON.stringify({ __end_stream__: true }));
        } catch (error) {
          console.error('Error sending input stream:', error);
          reject(error);
        }
      });

      ws.on('message', (data: WebSocket.Data) => {
        try {
          const message = JSON.parse(data.toString());
          const responseData = 'data' in message ? message.data : message;
          resolve(responseData as {{ output_type }});
        } catch (error) {
          console.error('Failed to parse response:', error);
          reject(error);
        }
      });

      ws.on('close', () => {
        reject(new Error('WebSocket connection closed unexpectedly'));
      });

      ws.on('error', (error) => {
        console.error('Error in client streaming:', error);
        reject(error);
      });
    });
  }

{% elif streaming_type == "bidirectional_streaming" %}
  async* {{ snake_name }}(
    inputStream: AsyncGenerator<{{ input_type }}, void, unknown>,
    headers?: Record<string, string>
